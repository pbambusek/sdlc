{
  "name": "sdlc-repo",
  "private": true,
  "description": "Development tooling for the sdlc plugin and foreman. None of it ships in the plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint --deny-warnings plugins tests foreman .github",
    "format": "oxfmt plugins/sdlc/skills/*/scripts tests foreman .github",
    "format:check": "oxfmt --check plugins/sdlc/skills/*/scripts tests foreman .github",
    "check:repo": "node .github/check.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
